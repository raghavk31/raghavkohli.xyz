<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- flag JS so scroll-reveal only hides content when it can be revealed again -->
    <script>document.documentElement.classList.add('js')</script>
    <title>{{ title or "Raghav Kohli" }}</title>
    <meta name="description" content="{{ description or 'Raghav Kohli: making invisible urban systems visible, legible, and participatory.' }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Geist:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/css/main.css" />
  </head>
  <body>
    <header class="head">
      <div class="head__in">
        <a class="mark" href="/">र.</a>
        <nav>
          <a class="head__work" href="/#work">(selected work)</a>
          <a href="/#about">(about)</a>
          <a href="/thoughts/">(thoughts)</a>
          <a href="/#contact">(contact)</a>
        </nav>
      </div>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <script src="/assets/js/main.js" defer></script>
  </body>
</html>
