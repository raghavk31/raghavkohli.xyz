---
layout: base.njk
---
{#- One figure system for every project image: natural ratio, width/height reserved,
    mono fig label + caption BELOW the image (never overlaid). -#}
{% macro plate(p, eager) %}
<figure class="plate{% if p.wide %} plate--wide{% endif %}{% if p.blend %} plate--blend{% endif %}">
  <div class="plate__img"><img src="{{ p.src }}" alt="{{ p.alt or p.cap }}"{% if p.w and p.h %} width="{{ p.w }}" height="{{ p.h }}"{% endif %}{% if eager %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %} /></div>
  {% if p.fig or p.cap %}<figcaption class="plate__cap">{% if p.fig %}<span class="n">{{ p.fig }}</span>{% endif %}{% if p.cap %}<span>{{ p.cap }}</span>{% endif %}</figcaption>{% endif %}
</figure>
{% endmacro %}
{#- Justified strip: widths proportional to w/h so every photo shares one height. `col: true` places
    it inside the plates column under the chapter's hero (stacks on the phone); an item's own `cap`
    becomes data-cap, the caption the lightbox shows for that photo (main.js captionFor). -#}
{% macro strip(s) %}
<figure class="plate{% if s.col %} strip--col{% endif %}">
  <div class="strip">{% for it in s.items %}<div style="--ar:{{ (it.ar or (it.w / it.h)) | round(3) }}"{% if it.cap %} data-cap="{{ it.cap }}"{% endif %}><img src="{{ it.src }}" alt="{{ it.alt or it.cap or '' }}"{% if it.w and it.h %} width="{{ it.w }}" height="{{ it.h }}"{% endif %} loading="lazy" /></div>{% endfor %}</div>
  {% if s.fig or s.cap %}<figcaption class="plate__cap">{% if s.fig %}<span class="n">{{ s.fig }}</span>{% endif %}{% if s.cap %}<span>{{ s.cap }}</span>{% endif %}</figcaption>{% endif %}
</figure>
{% endmacro %}
{#- City carousel: one spread at full width, a mono pager and a fifteen-segment rule; the ledger
    beside the text is its index (main.js initCarousel). Without JS: the first city, and every rule
    segment / ledger row is a real link to that spread. -#}
{% macro carousel(v, rows) %}
{% set first = rows[0] %}
<div class="chap__full carousel" data-carousel>
  <figure class="plate">
    <div class="plate__img"><img class="carousel__img" src="{{ first.resolve or first.src }}" alt="{{ first.city }}"{% if first.w and first.h %} width="{{ first.w }}" height="{{ first.h }}"{% endif %} loading="lazy" decoding="async" /></div>
    <figcaption class="plate__cap" aria-live="polite"><span class="n">{{ first.fig }}</span><span class="t">{{ first.city }} · {{ first.year }} inventory · {{ first.tco2e_pc | fixed(2) }} tCO₂e per person · {{ first.pop_m }} M people · CSCAF {{ first.cscaf }}/5</span></figcaption>
  </figure>
  <div class="carousel__nav">
    <a class="carousel__prev" href="{{ rows[rows.length - 1].src }}" data-step="-1">(&larr;<span class="long"> {{ rows[rows.length - 1].city | lower }}</span>)</a>
    <span class="carousel__pos">01 / {{ rows.length }} · {{ first.city | lower }}<span class="long"> · {{ first.year }}</span></span>
    <a class="carousel__next" href="{{ rows[1].src }}" data-step="1">(<span class="long">{{ rows[1].city | lower }} </span>&rarr;)</a>
  </div>
  <div class="carousel__rule" role="list">{% for r in rows %}<a role="listitem" href="{{ r.src }}" data-i="{{ loop.index0 }}"{% if loop.first %} class="on"{% endif %} title="{{ r.city }}" aria-label="{{ r.city }}"></a>{% endfor %}</div>
</div>
{% endmacro %}
{% macro ledger(v, rows) %}
{% set mx = v.max or 4 %}
<ol class="ledger">
  {% for r in rows %}
  <li><a href="{{ r.src }}" data-i="{{ loop.index0 }}" data-src="{{ r.resolve or r.src }}" data-full="{{ r.src }}" data-w="{{ r.w }}" data-h="{{ r.h }}" data-city="{{ r.city }}" data-fig="{{ r.fig }}" data-cap="{{ r.city }} · {{ r.year }} inventory · {{ r.tco2e_pc | fixed(2) }} tCO₂e per person · {{ r.pop_m }} M people · CSCAF {{ r.cscaf }}/5" aria-label="{{ r.city }} — {{ r.tco2e_pc | fixed(2) }} tonnes CO₂e per person, {{ r.pop_m }} million people, CSCAF {{ r.cscaf }} of 5, {{ r.year }} inventory"><span class="ledger__c">{{ r.city }}</span><span class="ledger__t" aria-hidden="true"><span class="ledger__b" style="width:{{ (100 * r.tco2e_pc / mx) | round(1) }}%"></span></span><span class="ledger__v" aria-hidden="true">{{ r.tco2e_pc | fixed(2) }}</span><span class="ledger__s" aria-hidden="true">{{ r.cscaf | stars }}</span></a></li>
  {% endfor %}
</ol>
{% if v.unit %}<div class="ledger__u"><span class="long">{{ v.unit }}</span><span class="short">{{ v.unit_short or v.unit }}</span></div>{% endif %}
{% endmacro %}
<article class="detail">
  <a class="detail__back" href="/#work">(&larr; selected work)</a>

  <span class="detail__qlabel">(research question)</span>
  <h1 class="detail__q reveal">{{ question }}</h1>
  {% if subtitle %}<p class="detail__sub reveal">{{ subtitle }}</p>{% endif %}

  <div class="detail__meta reveal">
    <div><div class="lbl">(role)</div><div class="val">{{ role }}</div></div>
    <div><div class="lbl">(period)</div><div class="val">{{ period }}</div></div>
    <div><div class="lbl">(context)</div><div class="val">{{ context }}</div></div>
    <div><div class="lbl">(status)</div><div class="val" style="color:{% if live %}var(--accent){% else %}var(--faint){% endif %}">{{ status }}</div></div>
  </div>

  {% if lead %}<p class="detail__lead reveal">{{ lead }}</p>{% endif %}

  {% if chapters %}
  {#- ===== chapter layout: the argument beside its evidence =====
      Body markdown is split at `## NN name` headings; each piece joins the chapter with that
      number. Text before the first numbered heading opens the first chapter. -#}
  {% set ch = content | chapters %}
  {% if open %}<div class="detail__open reveal">{{ plate(open, true) }}</div>{% endif %}

  {% for c in chapters %}
  {% set body = ch.byNum[c.n] or '' %}
  {% if loop.first and ch.intro %}{% set body = ch.intro + body %}{% endif %}
  {% set hasPlates = c.plates or c.pair or c.strip or c.carousel %}
  {% set hasText = body or c.title %}
  <section class="chap{% if c.side == 'left' %} chap--left{% endif %}{% if not hasPlates %} chap--noplates{% endif %}{% if c.narrow %} chap--narrow{% endif %}{% if not hasText %} chap--notext{% endif %}{% if c.narrow and hasText %} chap--coda{% endif %}{% if c.carousel %} chap--carousel{% endif %}{% if body.length > 1400 %} chap--long{% endif %} reveal" id="ch-{{ c.n }}">
    {% if c.carousel %}
    {#- carousel chapters: eyebrow, stat row, any full-width plates, the carousel, then text | ledger -#}
    <span class="chap__eyebrow chap__eyebrow--row"><b>({{ c.n }})</b> {{ c.name }}</span>
    {% if c.stats %}
    <div class="stats">
      {% for st in c.stats.items %}<div><div class="n">{{ st.n }}</div><div class="l">({{ st.l }})</div></div>{% endfor %}
      {% if c.stats.src %}<div class="src">{{ c.stats.src }}</div>{% endif %}
    </div>
    {% endif %}
    {% for p in c.plates %}<div class="chap__full">{{ plate(p) }}</div>{% endfor %}
    {% set rows = c.carousel.rows or (c.carousel.data | dataset) %}
    {{ carousel(c.carousel, rows) }}
    {% endif %}
    {% if hasText %}
    <div class="chap__txt">
      {% if not c.carousel %}<span class="chap__eyebrow"><b>({{ c.n }})</b> {{ c.name }}</span>{% endif %}
      {% if c.title %}<h2 class="chap__title">{{ c.title }}</h2>{% endif %}
      {% if body %}<div class="chap__body">{{ body | safe }}</div>{% endif %}
    </div>
    {% endif %}
    {% if c.carousel %}<div class="chap__pl">{{ ledger(c.carousel, rows) }}</div>{% endif %}
    {% if (c.plates or c.pair or (c.strip and c.strip.col)) and not c.carousel %}
    <div class="chap__pl">
      {% for p in c.plates %}{{ plate(p) }}{% endfor %}
      {% if c.pair %}<div class="pair">{% for p in c.pair %}{{ plate(p) }}{% endfor %}</div>{% endif %}
      {% if c.strip and c.strip.col %}{{ strip(c.strip) }}{% endif %}
    </div>
    {% endif %}
    {% if c.strip and not c.strip.col %}<div class="chap__full">{{ strip(c.strip) }}</div>{% endif %}
  </section>
  {% endfor %}

  {% if outcome %}
  <section class="detail__outcome{% if outcome.link %} detail__outcome--4{% endif %} reveal" aria-label="outcome">
    {% if outcome.built %}<div><div class="lbl">(outcome)</div><div class="val">{{ outcome.built }}</div></div>{% endif %}
    {% if outcome.recognised %}<div><div class="lbl">(recognition)</div><div class="val">{{ outcome.recognised }}</div></div>{% endif %}
    {% if outcome.next %}<div><div class="lbl">(what I'd do next)</div><div class="val">{{ outcome.next }}</div></div>{% endif %}
    {% if outcome.link %}<div><div class="lbl">({{ outcome.link.lbl or 'published' }})</div><div class="val"><a href="{{ outcome.link.href }}" target="_blank" rel="noopener">{{ outcome.link.label }} &rarr;</a></div></div>{% endif %}
  </section>
  {% endif %}

  {% else %}
  {#- ===== legacy layout (pages not yet curated into chapters) ===== -#}
  {% if mediaHero %}<div class="detail__hero-media reveal"><div class="fig">({{ mediaHero }})</div></div>{% endif %}

  {% if mediaPair %}
  <div class="detail__pair reveal">
    {% for m in mediaPair %}<div><div class="fig">({{ m }})</div></div>{% endfor %}
  </div>
  {% endif %}

  <div class="detail__body reveal">
    {{ content | safe }}
  </div>

  {% if gallery %}
  <div class="gallery">
    {% for g in gallery %}
    {# row: <name> on consecutive items -> one justified strip #}
    {% set prevRow = gallery[loop.index0 - 1].row if loop.index0 > 0 else '' %}
    {% set nextRow = gallery[loop.index0 + 1].row if not loop.last else '' %}
    {% if g.row and g.row != prevRow %}
    <figure class="g-row plate reveal">
      <div class="strip">
    {% endif %}
    {% if g.row %}
        <div style="--ar:{{ (g.ar or (g.w / g.h)) | round(3) }}"><img src="{{ g.src }}" alt="{{ g.cap }}"{% if g.w and g.h %} width="{{ g.w }}" height="{{ g.h }}"{% endif %} loading="lazy" /></div>
    {% else %}
    <figure class="g g--{{ g.size or 'md' }}{% if g.fit == 'natural' %} g--natural{% endif %}{% if g.break %} g--break{% endif %} reveal">
      <div class="g__frame">
        {% if g.src %}<img src="{{ g.src }}" alt="{{ g.cap }}"{% if g.w and g.h %} width="{{ g.w }}" height="{{ g.h }}"{% endif %} loading="lazy" />{% endif %}
      </div>
      {% if g.fig or g.cap %}<figcaption class="g__cap">{% if g.fig %}<span class="g__fig">{{ g.fig }}</span>{% endif %}{% if g.cap %}<span>{{ g.cap }}</span>{% endif %}</figcaption>{% endif %}
    </figure>
    {% endif %}
    {% if g.row and g.row != nextRow %}
      </div>
      {% if g.rowcap %}<figcaption class="plate__cap"><span>{{ g.rowcap }}</span></figcaption>{% endif %}
    </figure>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  {% if method %}
  <div class="reveal" style="margin-top:clamp(56px,8vw,96px)">
    <span class="eyebrow">(method)</span>
    <div style="display:flex;flex-direction:column;margin-top:36px">
      {% for m in method %}
      <div style="display:flex;gap:24px;padding:24px 0;border-top:1px solid rgba(28,27,24,.09)">
        <span class="mono" style="font-size:12px;color:var(--line);min-width:28px">{{ m.n }}</span>
        <div><div style="font-size:15px;font-weight:500;color:var(--ink);margin-bottom:6px">{{ m.title }}</div><div style="font-size:14px;color:var(--faint);max-width:34em">{{ m.body }}</div></div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {% endif %}

  {% if next %}
  <a class="detail__next reveal" href="/#work">
    <span class="lbl">(next)</span>
    <span class="nm">{{ next }}</span>
    <span style="color:var(--accent)">&rarr;</span>
  </a>
  {% endif %}
</article>
