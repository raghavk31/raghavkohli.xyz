---
layout: base.njk
title: "Raghav Kohli · invisible systems, made visible"
---

{#- The card: frame (thumb + rotating covers), glass overlay with the research question, floating meta
    panel, caption, and the strip of covers. Width comes from `card:`. L → span 6, two per row;
    M → span 4, three per row; S → span 3, four per row (internal only, never displayed): the grid's auto-placement packs rows to
    twelve columns and wraps a card that would not fit, so packing is free. The frame ratio follows
    the cover: landscape keeps its own ratio, near-square becomes 1:1, portrait becomes 4:5 with the
    image contained on the page paper: nothing is cropped (plan 2026-09-19, D8/D11). -#}
{% macro card(p, num) %}
{#- card: L | M | S in the frontmatter (internal: never shown); numeric weight 1|2|3 still accepted -#}
{%- set sz = (p.data.card or '') | upper -%}
{%- set w = 1 if sz == 'L' else (3 if sz == 'S' else (p.data.weight or 2)) -%}
{%- set span = 6 if w == 1 else (4 if w == 2 else 3) -%}
{%- set r = (p.data.thumbw / p.data.thumbh) if (p.data.thumbw and p.data.thumbh) else 1.333 -%}
{%- if r < 0.9 %}{% set car = "0.8" %}{% set contain = true %}
{%- elif r <= 1.1 %}{% set car = "1" %}{% set contain = true %}
{%- else %}{% set car = r | round(3) %}{% set contain = (p.data.thumbfit == 'contain') %}{% endif -%}
<figure class="card w{{ w }}"
        data-topics="{{ (p.data.topics or []) | join(' ') }}" data-weight="{{ w }}"
        style="--span:{{ span }};--car:{{ car }};--cpad:{{ 36 if w == 1 else (30 if w == 2 else 22) }}px;--cq:{{ p.data.qsize or '24px' }};">
  <a class="card__click" href="{{ p.url }}" data-project="{{ p.url }}">
    <div class="card__meta right">
      <div><span class="lbl">(role)</span><span class="val">{{ p.data.role }}</span></div>
      <div><span class="lbl">(period)</span><span class="val">{{ p.data.period }}</span></div>
      <div><span class="lbl">(context)</span><span class="val">{{ p.data.context }}</span></div>
      <div><span class="lbl">(status)</span><span class="val{% if p.data.live %} live{% endif %}">{{ p.data.status }}</span></div>
    </div>
    <div class="card__frame">
      {% if p.data.thumb %}<img src="{{ p.data.thumb }}" alt="{{ p.data.title }}"{% if contain %} class="contain"{% endif %} loading="lazy" onerror="this.remove()" />{% endif %}
      {#- rotating covers (scripts/prep-covers.py): pre-cropped to the frame ratio; main.js initCovers crossfades them -#}
      {% for c in p.data.covers %}<img class="card__alt{% if contain %} contain{% endif %}" src="{{ c.f }}" alt="" width="{{ c.w }}" height="{{ c.h }}" loading="lazy" data-i="{{ loop.index }}" />{% endfor %}
      <div class="card__fig">{{ p.data.fig }}</div>
      <div class="card__overlay">
        <span class="card__qlabel">(research question)</span>
        <p class="card__q">{{ p.data.question }}</p>
        <span class="card__view">(view project &rarr;)</span>
      </div>
    </div>
    <figcaption>
      <span class="n">{{ num }}</span>
      <span class="name">{{ p.data.title }}</span>
      <span class="desc">{{ p.data.desc }}</span>
      {% if p.data.live %}<span class="status">({{ p.data.status }})</span>{% endif %}
    </figcaption>
    {%- if p.data.covers and p.data.covers.length -%}
    <div class="card__thumbs" aria-hidden="true">
      {% for c in p.data.covers %}<div class="card__thumb" data-i="{{ loop.index }}" tabindex="-1"><img src="{{ c.t }}" alt="" width="400" height="400" loading="lazy" /></div>{% endfor %}
    </div>
    {%- endif %}
  </a>
</figure>
{% endmacro %}

{#- A group break: a 12-column hairline with the (label) under it. Hidden while a chip filter is
    active (main.js adds .filtering to the grid). -#}
{% macro brk(label) %}
<div class="work__break" role="presentation"><span class="eyebrow">{{ label }}</span></div>
{% endmacro %}

{%- set P = collections.projects -%}
{#- Groups by method (plan 2026-09-19, D4). Order inside a group = the media lab plan's order. -#}
{%- set groups = [
  ["(plans & policy)",          ["Malaysia GCAP", "Ahmedabad Climate Action Plan", "State of Cities", "Urban Greening Policy", "Vadodara Climate Action Plan", "Surat Climate Action Plan"]],
  ["(participatory)",           ["Koliwadas", "Living Heritage", "Rebel Bodies Rebel Cities", "Urban Performances"]],
  ["(computational & spatial)", ["Generative Techniques", "One is to One", "Water Urbanism", "Eco-Machine"]],
  ["(early work)",              ["Utopias to Heterotopias", "Exploring Majuli", "Pune Metro"]]
] -%}

<h1 class="vh">Raghav Kohli: making invisible urban systems visible, legible, and participatory</h1>

<section class="work" id="work">
  <div class="work__head reveal" data-reveal>
    <h2 class="eyebrow">(selected work)</h2>
    <div class="work__lead">
      <p class="work__tag">making invisible urban systems <em>visible</em>, <em>legible</em>, and <em>participatory</em>.</p>
      <!-- keyword chips injected by main.js from each card's data-topics -->
      <div class="work__filters" data-filters aria-label="filter by keyword"></div>
    </div>
  </div>

  <!-- 12-column grid. Card width = weight (span 6 / 4 / 3); rows pack themselves. A chip filter
       re-weights every card by its relevance to the tag and repacks (main.js). -->
  <div class="work__grid" data-grid>
    {%- set n = 0 -%}
    {%- for g in groups %}
    {{ brk(g[0]) }}
    {#- rows: pack cards greedily to twelve column-units; a card that would overflow starts a new
        row. Inside a row the cards stretch in proportion (flex-grow = span), so every row fills the
        width and a size is read against its neighbours. main.js repacks the same way when filtering. -#}
    {%- set fill = 0 -%}
    {%- for title in g[1] %}
      {%- set p = P | find("title", title) -%}
      {%- set sz = (p.data.card or '') | upper -%}
      {%- set span = 6 if sz == 'L' else (3 if sz == 'S' else 4) -%}
      {%- if loop.first %}<div class="work__row">{% elif fill + span > 12 %}</div><div class="work__row">{% set fill = 0 %}{% endif -%}
      {%- set fill = fill + span -%}
      {%- set n = n + 1 -%}
      {{ card(p, ("0" + n) if n < 10 else n) }}
      {%- if loop.last %}</div>{% endif -%}
    {%- endfor %}
    {%- endfor %}
  </div>
</section>

<section class="about" id="about">
  <div class="reveal" data-reveal>
    <h2 class="eyebrow">(about) <span class="about__now">· (now)</span></h2>
    {#- the (now) statement: the current research question, in the register the tagline used to
        hold here (plan 2026-09-19, D7). Draft. Raghav edits once the sama paragraph lands. -#}
    <blockquote class="about__quote">what would a city&rsquo;s climate ledger look like if the people inside it could <em>read</em> it, <em>argue</em> with it, and <em>change</em> it?</blockquote>

    <p class="about__body">
      I work from inside the systems I study, energy, carbon, the street, and build the
      tools that let the people already living there read and reshape their own flows.
      Most of the work on this page asks one question at a different scale each time:
      what does a place need to see about itself before it can change? The methods are
      fieldwork, participatory mapping, climate inventories and design that stays close
      to the ground.
    </p>

    <button type="button" class="about__expand" aria-expanded="false" aria-controls="about-cv">
      <span>full cv</span>
      <svg class="about__chev" width="15" height="15" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </button>

    <div class="about__cv" id="about-cv">
      <div class="about__cv-inner">
        <div class="cv-sec">
          <span class="eyebrow">(experience)</span>
          <div class="cv-item">
            <div class="cv-head"><span class="cv-role">Co-founder &middot; Perspectives</span><span class="cv-year">2025</span></div>
            <ul class="cv-bullets">
              <li>Built a community platform to 1,000+ members, entirely word of mouth. Designed every touchpoint: onboarding, session frameworks, facilitation methodology.</li>
              <li>5,000+ stories taught me: a billion humans, a handful of emotions. The most consistent need was finding someone going through the same thing, and the product was built around that.</li>
              <li>Used frontier language models throughout, moving from raw qualitative data to testable product decisions in hours.</li>
            </ul>
          </div>
          <div class="cv-item">
            <div class="cv-head"><span class="cv-role">Project Officer, Climate &amp; Energy &middot; ICLEI South Asia</span><span class="cv-year">2024</span></div>
            <ul class="cv-bullets">
              <li>Built climate resilience action plans for 10+ South Asian cities; wrote Loss &amp; Damage policy briefs for international climate negotiations.</li>
              <li>Led the Urban95 Child-Friendly Cities assessment in Udaipur: ethnographic fieldwork with children and caregivers, translated into spatial design recommendations.</li>
            </ul>
          </div>
          <div class="cv-item">
            <div class="cv-head"><span class="cv-role">Climate Fellow &middot; NIUA / MoHUA India</span><span class="cv-year">2023</span></div>
            <ul class="cv-bullets">
              <li>Co-authored <em>State of Cities</em>, a national policy report across 15+ Indian cities, published by the Ministry of Housing and Urban Affairs.</li>
              <li>Built a Nature-based Solutions Toolkit of community micro-interventions, adopted by urban local bodies across India.</li>
            </ul>
          </div>
          <div class="cv-item">
            <div class="cv-head"><span class="cv-role">Urban Design Consultant &middot; CCBA Designs</span><span class="cv-year">2021</span></div>
            <ul class="cv-bullets">
              <li>Drew station layouts and a station-area massing study for Pune Metro Line 3, working on how the structure meets the street.</li>
            </ul>
          </div>
        </div>

        <div class="cv-sec">
          <span class="eyebrow">(education)</span>
          <div class="cv-item">
            <div class="cv-head"><span class="cv-role">Bachelor of Urban Design &middot; CEPT University</span><span class="cv-year">2017&ndash;2022</span></div>
            <ul class="cv-bullets">
              <li>Student Excellence Award for <em>Living Heritage</em>, a community co-design process with residents who had never been asked what they wanted.</li>
              <li><em>Reverse Effect</em>, an undergraduate thesis on Mumbai's koliwadas: a semester of fieldwork in Worli Koliwada, reading the fishing village's commons as a model for the city.</li>
            </ul>
          </div>
        </div>

        <div class="cv-sec">
          <span class="eyebrow">(skills)</span>
          <div class="cv-line"><span class="cv-key">research</span><span class="cv-val">ethnographic fieldwork &middot; cultural probing &middot; in-depth interviews &middot; participatory design &middot; contextual inquiry &middot; survey design</span></div>
          <div class="cv-line"><span class="cv-key">synthesis</span><span class="cv-val">qualitative insight &rarr; action &middot; insight frameworks &middot; policy brief writing &middot; stakeholder storytelling</span></div>
          <div class="cv-line"><span class="cv-key">computation</span><span class="cv-val">parametric &amp; generative design &middot; ArcGIS &middot; Python &middot; R &middot; Tableau &middot; Rhino &middot; Grasshopper &middot; spatial analysis &middot; ML fundamentals</span></div>
          <div class="cv-line"><span class="cv-key">ai &amp; tools</span><span class="cv-val">daily hands-on frontier AI models &middot; built AI products from scratch &middot; Figma &middot; IBM Data Science certified</span></div>
          <div class="cv-line"><span class="cv-key">human</span><span class="cv-val">Stanford GSB interpersonal dynamics intensive &middot; facilitation design &middot; deep listening &middot; behaviour change</span></div>
        </div>

        <div class="cv-sec">
          <span class="eyebrow">(additional)</span>
          <div class="cv-line"><span class="cv-key">certifications</span><span class="cv-val">IBM Data Science &middot; ESRI GIS for Climate Action &middot; Computational Design Workshop, UPenn</span></div>
          <div class="cv-line"><span class="cv-key">recognition</span><span class="cv-val">Urban design competition wins: Blankspace, Project Platypus, Gaudi &middot; Big O&rsquo;s installation, International Literature Festival Ahmedabad</span></div>
          <div class="cv-line"><span class="cv-key">leadership</span><span class="cv-val">Founded Urban Informal Talk Series &middot; G20 Urban-20 Forum contributor</span></div>
        </div>

      </div>
    </div>
  </div>
</section>

<section class="index" id="index">
  <div class="index__head reveal" data-reveal>
    <h2 class="eyebrow">(index)</h2>
    <span class="index__hint">the fuller archive · hover a line to preview</span>
  </div>
  <div class="index__grid reveal" data-reveal>
    <div class="index__list" data-idxlist>
      {% for e in archive %}
      <a class="index__row{% if loop.first %} on{% endif %}" href="{{ e.href or '#index' }}"
         data-media="{{ e.media }}" data-name="{{ e.name }}" data-blurb="{{ e.blurb }}">
        <span class="n">{{ e.n }}</span>
        <span class="nm">{{ e.name }}</span>
        <span class="cat">{{ e.cat }}</span>
        <span class="yr">{{ e.year }}</span>
      </a>
      {% endfor %}
      <div class="index__end"></div>
    </div>
    <div class="index__preview">
      <div class="index__pv-img"><div class="fig" data-pv="media">{{ archive[0].media }}</div></div>
      <div class="index__pv-name" data-pv="name">{{ archive[0].name }}</div>
      <p class="index__pv-blurb" data-pv="blurb">{{ archive[0].blurb }}</p>
    </div>
  </div>
</section>

<footer class="contact" id="contact" role="contentinfo">
  <div class="reveal" data-reveal>
    <h2 class="eyebrow">(contact)</h2>
    <div class="contact__row">
      <a class="contact__email" href="mailto:{{ site.email }}">{{ site.email }}</a>
      <nav class="contact__links">
        {% if site.scholar %}<a href="{{ site.scholar }}">(scholar)</a>{% endif %}
        {% if site.github %}<a href="{{ site.github }}">(github)</a>{% endif %}
        {% if site.linkedin %}<a href="{{ site.linkedin }}">(linkedin)</a>{% endif %}
      </nav>
    </div>
    <div class="contact__fine">&copy; {{ '' | year }} &middot; making invisible systems visible, legible, and participatory.</div>
  </div>
</footer>

<!-- Project detail. Zooms open from the clicked card (progressive enhancement;
     the card's href still deep-links to /work/<slug>/ when JS is off) -->
<div class="pv" id="pv" aria-hidden="true">
  <div class="pv__backdrop" data-pv-close></div>
  <div class="pv__panel" role="dialog" aria-modal="true" aria-label="Project detail">
    <div class="pv__bar">
      <button type="button" class="pv__nav" data-pv-close>(&larr; selected work)</button>
      <span class="pv__barname" data-pv="name"></span>
      <button type="button" class="pv__nav" data-pv-close>(close)</button>
    </div>
    <div class="pv__body">
      <span class="pv__qlabel">(research question)</span>
      <h2 class="pv__q" data-pv="question"></h2>
      <p class="pv__sub" data-pv="subtitle" hidden></p>
      <div class="pv__meta">
        <div><div class="lbl">(role)</div><div class="val" data-pv="role"></div></div>
        <div><div class="lbl">(period)</div><div class="val" data-pv="period"></div></div>
        <div><div class="lbl">(context)</div><div class="val" data-pv="context"></div></div>
        <div><div class="lbl">(status)</div><div class="val" data-pv="status"></div></div>
      </div>
      <p class="pv__lead" data-pv="lead"></p>
      <div class="pv__hero"><div class="fig" data-pv="mediaHero"></div></div>
      <div class="pv__pair" data-pv-pair></div>
      <div class="gallery pv__gallery" data-pv-gallery hidden></div>
      <div class="pv__methodwrap" data-pv-methodwrap>
        <span class="eyebrow">(method)</span>
        <div class="pv__method" data-pv-method></div>
      </div>
      <a class="pv__next" href="#work" data-pv-close>
        <span class="eyebrow">(next)</span>
        <span class="pv__nextname" data-pv="next"></span>
        <span class="pv__arrow">&rarr;</span>
      </a>
    </div>
  </div>
</div>

<script id="pvdata" type="application/json">
{
{%- for p in collections.projects %}
  {{ p.url | dump | safe }}: {
    "name": {{ p.data.title | dump | safe }},
    "question": {{ p.data.question | dump | safe }},
    "subtitle": {{ (p.data.subtitle or "") | dump | safe }},
    "gallery": {{ (p.data.gallery or []) | dump | safe }},
    "role": {{ p.data.role | dump | safe }},
    "period": {{ p.data.period | dump | safe }},
    "context": {{ p.data.context | dump | safe }},
    "status": {{ p.data.status | dump | safe }},
    "live": {{ (p.data.live or false) | dump | safe }},
    "lead": {{ (p.data.lead or "") | dump | safe }},
    "mediaHero": {{ (p.data.mediaHero or "") | dump | safe }},
    "mediaPair": {{ (p.data.mediaPair or []) | dump | safe }},
    "method": {{ (p.data.method or []) | dump | safe }},
    "next": {{ (p.data.next or "") | dump | safe }}
  }{% if not loop.last %},{% endif %}
{%- endfor %}
}
</script>
