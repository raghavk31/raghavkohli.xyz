---
layout: base.njk
title: Raghav Kohli — invisible systems, made visible
---

{#- Faithful port of Portfolio.dc.html: composed grid, hover reveals, zoom-open detail -#}
{% macro card(p, num, col, mt, aspect, pad, thumbs) %}
<figure class="card reveal" data-reveal
        data-topics="{{ (p.data.topics or []) | join(' ') }}"
        style="grid-column:{{ col }};--cmt:{{ mt }}px;--car:{{ aspect }};--cpad:{{ pad }}px;--cq:{{ p.data.qsize or '24px' }};">
  <a class="card__click" href="{{ p.url }}" data-project="{{ p.url }}">
    <div class="card__meta right">
      <div><span class="lbl">(role)</span><span class="val">{{ p.data.role }}</span></div>
      <div><span class="lbl">(period)</span><span class="val">{{ p.data.period }}</span></div>
      <div><span class="lbl">(context)</span><span class="val">{{ p.data.context }}</span></div>
      <div><span class="lbl">(status)</span><span class="val{% if p.data.live %} live{% endif %}">{{ p.data.status }}</span></div>
    </div>
    <div class="card__frame">
      {% if p.data.thumb %}<img src="{{ p.data.thumb }}" alt="{{ p.data.title }}" loading="lazy" onerror="this.remove()" />{% endif %}
      <div class="card__fig">{{ p.data.fig }}</div>
      <div class="card__overlay">
        <span class="card__qlabel">(research question)</span>
        <p class="card__q">{{ p.data.question }}</p>
        <span class="card__view">(view project &rarr;)</span>
      </div>
    </div>
    <figcaption>
      <span class="n">{{ num }}</span>
      <span class="name">{{ p.data.title }}</span>
      <span class="desc">{{ p.data.desc }}</span>
      {% if p.data.live %}<span class="status">({{ p.data.status }})</span>{% endif %}
    </figcaption>
    <div class="card__thumbs">
      {% for i in range(0, thumbs) %}<div class="card__thumb"><span>{{ ["a","b","c","d"][i] }}</span></div>{% endfor %}
    </div>
  </a>
</figure>
{% endmacro %}

{%- set P = collections.projects -%}
{%- set sama = P | find("title", "sama") -%}
{%- set koliwadas = P | find("title", "koliwadas") -%}
{%- set perspectives = P | find("title", "perspectives") -%}
{%- set city = P | find("title", "city-scale climate") -%}
{%- set climatecode = P | find("title", "climate code india") -%}
{%- set punemetro = P | find("title", "pune metro") -%}
{%- set academic = P | find("title", "selected academic") -%}

<section class="work" id="work">
  <div class="work__head reveal" data-reveal>
    <span class="eyebrow">(selected work)</span>
    <!-- keyword chips injected by main.js from each card's data-topics -->
    <div class="work__filters" data-filters aria-label="filter by keyword"></div>
  </div>

  <!-- 12-column grid. Per-card grid-column span + --cmt offset reproduce the
       composed, floating landing layout; the filter reorders + resizes within
       this one container (it flips to flex while a chip is active). -->
  <div class="work__grid" data-grid>
    {{ card(sama, "01", "1 / 7", 70, "4/5", 36, 4) }}
    {{ card(koliwadas, "02", "9 / 13", 0, "3/4", 30, 3) }}
    {{ card(perspectives, "03", "1 / 5", 36, "4/5", 30, 3) }}
    {{ card(city, "04", "7 / 13", 130, "5/4", 36, 4) }}
    {{ card(climatecode, "05", "1 / 4", 0, "5/6", 24, 3) }}
    {{ card(punemetro, "06", "5 / 8", 78, "4/5", 24, 3) }}
    {{ card(academic, "07", "9 / 12", 28, "4/5", 24, 3) }}
  </div>
</section>

<section class="about" id="about">
  <div class="reveal" data-reveal>
    <span class="eyebrow">(about)</span>
    <blockquote class="about__quote">making invisible systems <em>visible</em>, <em>legible</em>, and <em>participatory</em>.</blockquote>

    <p class="about__body">
      I work from inside the systems I study &mdash; energy, carbon, the street &mdash;
      building tools that let the people already living there read and reshape their
      own flows. The practice is single-minded rather than broad: one obsession,
      pursued through instrumentation, participatory method, and design that stays
      close to the ground.
    </p>

    <button type="button" class="about__expand" aria-expanded="false" aria-controls="about-cv">
      <span>full cv</span>
      <svg class="about__chev" width="15" height="15" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </button>

    <div class="about__cv" id="about-cv">
      <div class="about__cv-inner">
        <p class="about__cv-lead">
          I spend my time where the data runs out &mdash; fishing villages in Mumbai, government
          planning rooms across South Asia, informal housing in Indian cities &mdash; getting close
          enough to people to understand what&rsquo;s actually driving them. That research has become
          products I&rsquo;ve built from scratch and policies adopted at national scale.
        </p>

        <div class="cv-sec">
          <span class="eyebrow">(experience)</span>
          <div class="cv-item">
            <div class="cv-head"><span class="cv-role">Co-founder &middot; Perspectives</span><span class="cv-year">2025</span></div>
            <ul class="cv-bullets">
              <li>Built a community platform to 1,000+ members, entirely word of mouth. Designed every touchpoint: onboarding, session frameworks, facilitation methodology.</li>
              <li>5,000+ stories taught me: a billion humans, a handful of emotions. The most consistent need was finding someone going through the same thing &mdash; built the product around that insight.</li>
              <li>Used frontier language models throughout &mdash; moving from raw qualitative data to testable product decisions in hours.</li>
            </ul>
          </div>
          <div class="cv-item">
            <div class="cv-head"><span class="cv-role">Project Officer, Climate &amp; Energy &middot; ICLEI South Asia</span><span class="cv-year">2024</span></div>
            <ul class="cv-bullets">
              <li>Built climate resilience action plans for 10+ South Asian cities; wrote Loss &amp; Damage policy briefs for international climate negotiations.</li>
              <li>Led the Urban95 Child-Friendly Cities assessment in Udaipur &mdash; ethnographic fieldwork with children and caregivers, translated into spatial design recommendations.</li>
            </ul>
          </div>
          <div class="cv-item">
            <div class="cv-head"><span class="cv-role">Climate Fellow &middot; NIUA / MoHUA India</span><span class="cv-year">2023</span></div>
            <ul class="cv-bullets">
              <li>Co-authored <em>State of Cities</em> &mdash; national policy report across 15+ Indian cities, published by the Ministry of Housing and Urban Affairs.</li>
              <li>Built a Nature-based Solutions Toolkit of community micro-interventions &mdash; adopted by urban local bodies across India.</li>
            </ul>
          </div>
          <div class="cv-item">
            <div class="cv-head"><span class="cv-role">Urban Design Consultant &middot; CCBA Designs</span><span class="cv-year">2021</span></div>
            <ul class="cv-bullets">
              <li>Designed pedestrian connectivity and last-mile access for Pune Metro station interfaces &mdash; turning infrastructure constraints into human-scale spatial experience.</li>
            </ul>
          </div>
        </div>

        <div class="cv-sec">
          <span class="eyebrow">(education)</span>
          <div class="cv-item">
            <div class="cv-head"><span class="cv-role">Bachelor of Urban Design &middot; CEPT University</span><span class="cv-year">2017&ndash;2022</span></div>
            <ul class="cv-bullets">
              <li>Student Excellence Award &mdash; <em>Living Heritage</em>: a community co-design process with residents who had never been asked what they wanted.</li>
              <li><em>Reverse Effekt</em> &mdash; five months embedded across 12 Koliwada fishing communities in Mumbai, surfacing invisible territorial systems through storytelling and deep listening.</li>
            </ul>
          </div>
        </div>

        <div class="cv-sec">
          <span class="eyebrow">(skills)</span>
          <div class="cv-line"><span class="cv-key">research</span><span class="cv-val">ethnographic fieldwork &middot; cultural probing &middot; in-depth interviews &middot; participatory design &middot; contextual inquiry &middot; survey design</span></div>
          <div class="cv-line"><span class="cv-key">synthesis</span><span class="cv-val">qualitative insight &rarr; action &middot; insight frameworks &middot; policy brief writing &middot; stakeholder storytelling</span></div>
          <div class="cv-line"><span class="cv-key">computation</span><span class="cv-val">parametric &amp; generative design &middot; ArcGIS &middot; Python &middot; R &middot; Tableau &middot; Rhino &middot; Grasshopper &middot; spatial analysis &middot; ML fundamentals</span></div>
          <div class="cv-line"><span class="cv-key">ai &amp; tools</span><span class="cv-val">daily hands-on frontier AI models &middot; built AI products from scratch &middot; Figma &middot; IBM Data Science certified</span></div>
          <div class="cv-line"><span class="cv-key">human</span><span class="cv-val">Stanford GSB interpersonal dynamics intensive &middot; facilitation design &middot; deep listening &middot; behaviour change</span></div>
        </div>

        <div class="cv-sec">
          <span class="eyebrow">(additional)</span>
          <div class="cv-line"><span class="cv-key">certifications</span><span class="cv-val">IBM Data Science &middot; ESRI GIS for Climate Action &middot; Computational Design Workshop, UPenn</span></div>
          <div class="cv-line"><span class="cv-key">recognition</span><span class="cv-val">Urban design competition wins &mdash; Blankspace, Project Platypus, Gaudi &middot; Big O&rsquo;s installation, International Literature Festival Ahmedabad</span></div>
          <div class="cv-line"><span class="cv-key">leadership</span><span class="cv-val">Founded Urban Informal Talk Series &middot; G20 Urban-20 Forum contributor</span></div>
        </div>

        <a class="about__cv-download" href="/assets/Raghav_Kohli_CV.pdf" target="_blank" rel="noopener">download full cv (pdf) &rarr;</a>
      </div>
    </div>
  </div>
</section>

<section class="index" id="index">
  <div class="index__head reveal" data-reveal>
    <span class="eyebrow">(index)</span>
    <span class="index__hint">the fuller archive &mdash; hover a line to preview</span>
  </div>
  <div class="index__grid reveal" data-reveal>
    <div class="index__list" data-idxlist>
      {% for e in archive %}
      <a class="index__row{% if loop.first %} on{% endif %}" href="{{ e.href or '#index' }}"
         data-media="{{ e.media }}" data-name="{{ e.name }}" data-blurb="{{ e.blurb }}">
        <span class="n">{{ e.n }}</span>
        <span class="nm">{{ e.name }}</span>
        <span class="cat">{{ e.cat }}</span>
        <span class="yr">{{ e.year }}</span>
      </a>
      {% endfor %}
      <div class="index__end"></div>
    </div>
    <div class="index__preview">
      <div class="index__pv-img"><div class="fig" data-pv="media">{{ archive[0].media }}</div></div>
      <div class="index__pv-name" data-pv="name">{{ archive[0].name }}</div>
      <p class="index__pv-blurb" data-pv="blurb">{{ archive[0].blurb }}</p>
    </div>
  </div>
</section>

<section class="contact" id="contact">
  <div class="reveal" data-reveal>
    <span class="eyebrow">(contact)</span>
    <div class="contact__row">
      <a class="contact__email" href="mailto:{{ site.email }}">{{ site.email }}</a>
      <nav class="contact__links">
        {% if site.scholar %}<a href="{{ site.scholar }}">(scholar)</a>{% endif %}
        {% if site.github %}<a href="{{ site.github }}">(github)</a>{% endif %}
        {% if site.linkedin %}<a href="{{ site.linkedin }}">(linkedin)</a>{% endif %}
      </nav>
    </div>
    <div class="contact__fine">&copy; {{ '' | year }} &middot; making invisible systems visible, legible, and participatory.</div>
  </div>
</section>

<!-- Project detail — zooms open from the clicked card (progressive enhancement;
     the card's href still deep-links to /work/<slug>/ when JS is off) -->
<div class="pv" id="pv" aria-hidden="true">
  <div class="pv__backdrop" data-pv-close></div>
  <div class="pv__panel" role="dialog" aria-modal="true" aria-label="Project detail">
    <div class="pv__bar">
      <button type="button" class="pv__nav" data-pv-close>(&larr; selected work)</button>
      <span class="pv__barname" data-pv="name"></span>
      <button type="button" class="pv__nav" data-pv-close>(close)</button>
    </div>
    <div class="pv__body">
      <span class="pv__qlabel">(research question)</span>
      <h2 class="pv__q" data-pv="question"></h2>
      <div class="pv__meta">
        <div><div class="lbl">(role)</div><div class="val" data-pv="role"></div></div>
        <div><div class="lbl">(period)</div><div class="val" data-pv="period"></div></div>
        <div><div class="lbl">(context)</div><div class="val" data-pv="context"></div></div>
        <div><div class="lbl">(status)</div><div class="val" data-pv="status"></div></div>
      </div>
      <p class="pv__lead" data-pv="lead"></p>
      <div class="pv__hero"><div class="fig" data-pv="mediaHero"></div></div>
      <div class="pv__pair" data-pv-pair></div>
      <div class="pv__methodwrap" data-pv-methodwrap>
        <span class="eyebrow">(method)</span>
        <div class="pv__method" data-pv-method></div>
      </div>
      <a class="pv__next" href="#work" data-pv-close>
        <span class="eyebrow">(next)</span>
        <span class="pv__nextname" data-pv="next"></span>
        <span class="pv__arrow">&rarr;</span>
      </a>
    </div>
  </div>
</div>

<script id="pvdata" type="application/json">
{
{%- for p in collections.projects %}
  {{ p.url | dump | safe }}: {
    "name": {{ p.data.title | dump | safe }},
    "question": {{ p.data.question | dump | safe }},
    "role": {{ p.data.role | dump | safe }},
    "period": {{ p.data.period | dump | safe }},
    "context": {{ p.data.context | dump | safe }},
    "status": {{ p.data.status | dump | safe }},
    "live": {{ (p.data.live or false) | dump | safe }},
    "lead": {{ (p.data.lead or "") | dump | safe }},
    "mediaHero": {{ (p.data.mediaHero or "") | dump | safe }},
    "mediaPair": {{ (p.data.mediaPair or []) | dump | safe }},
    "method": {{ (p.data.method or []) | dump | safe }},
    "next": {{ (p.data.next or "") | dump | safe }}
  }{% if not loop.last %},{% endif %}
{%- endfor %}
}
</script>
